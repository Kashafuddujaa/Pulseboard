PORT=4000

# Supabase Postgres — pooled connection (port 6543), used by the app at runtime.
# Get this from Project Settings -> Database -> Connection string -> Transaction pooler.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Postgres — session pooler (port 5432, IPv4-compatible), used for Prisma
# migrations. Use the "Session pooler" string, NOT the raw db.<ref>.supabase.co
# direct host — that one is IPv6-only and often unreachable.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Project Settings -> API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[ANON_PUBLIC_KEY]"
# Used server-side only, to call Supabase's Admin API (e.g. inviting team members).
# NEVER expose this to the frontend — it bypasses all access control.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Auth middleware verifies tokens via Supabase's public JWKS endpoint
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json), so no shared JWT secret is
# needed — this only works for projects using Supabase's newer asymmetric
# (ES256) signing keys, which is the default for new projects.
